{
  "name": "kai-hq",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "npm run generate:fallback && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "generate:resumes": "tsx scripts/generate-resumes.ts",
    "generate:fallback": "tsx scripts/generate-fallback.ts",
    "test:phase4": "tsx scripts/test-phase4-voice-motion.ts",
    "test:routing": "tsx scripts/test-routing.ts",
    "test:knowledge": "tsx scripts/test-knowledge-engine.ts",
    "test:phase6-1": "tsx scripts/test-phase6-1-accessibility.ts",
    "test:phase6-2": "tsx scripts/test-phase6-2-fallback.ts",
    "test:parity": "vitest run tests/fallback-parity.test.ts",
    "test:fallback-a11y": "vitest run tests/fallback-accessibility.test.ts",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test:knowledge && npm run test:routing && npm run test:phase4 && npm run test:phase6-1 && npm run test:phase6-2 && npm run test:unit",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@hcaptcha/react-hcaptcha": "^2.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pdfkit": "^0.17.7",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "pdfkit": "^0.20.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1",
    "vitest": "^5.1.0",
    "vitest-axe": "^0.1.0"
  }
}
